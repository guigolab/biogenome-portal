proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=my_cache:10m max_size=10g inactive=60m;

server {
    gzip             on;
    gzip_types      text/tab-separated-values application/json;
    
    root /usr/share/nginx/html;

    listen ${API_PORT};

    # Exact match: never fall through to SPA index.html (try_files) — fixes broken portal.json injection.
    location = ${BASE_PATH}/portal.json {
        alias /usr/share/nginx/html/portal.json;
        default_type application/json;
        add_header Cache-Control "public, max-age=120";
    }

    location ${BASE_PATH} {
        rewrite ${BASE_PATH}/(.*) /$1 break;
        try_files $uri $uri/ /index.html;
        client_max_body_size 1000M;
    }

    location ${BASE_PATH}/api {
        rewrite ${BASE_PATH}(/.*) $1 break;

        # Proxy to backend over HTTP (avoids uWSGI protocol issues and "client closed connection")
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${BASE_PATH};

        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        # Cache
        proxy_cache my_cache;
        proxy_cache_valid 200 10m;
        proxy_cache_methods GET HEAD;
        proxy_cache_key $scheme$proxy_host$request_uri;

        client_max_body_size 1000M;
    }
}
