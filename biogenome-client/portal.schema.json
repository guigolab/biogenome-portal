{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "portal.schema.json",
   "title": "BioGenome portal configuration",
   "type": "object",
   "required": ["general", "models"],
   "additionalProperties": false,
   "properties": {
      "$schema": {
         "type": "string",
         "description": "Optional pointer to this schema (for editor validation)."
      },
      "general": {
         "type": "object",
         "description": "Portal-wide settings (branding, feature flags, languages, etc.).",
         "additionalProperties": true
      },
      "theme": {
         "type": "object",
         "additionalProperties": false,
         "required": ["colors"],
         "properties": {
            "colors": {
               "type": "object",
               "additionalProperties": false,
               "required": ["variables"],
               "properties": {
                  "threshold": { "type": "number" },
                  "variables": {
                     "type": "object",
                     "additionalProperties": { "type": "string" }
                  }
               }
            }
         }
      },
      "models": {
         "type": "object",
         "minProperties": 1,
         "propertyNames": {
            "enum": [
               "annotations",
               "assemblies",
               "biosamples",
               "local_samples",
               "organisms",
               "reads"
            ]
         },
         "additionalProperties": {
            "$ref": "#/$defs/model"
         }
      }
   },
   "$defs": {
      "i18nStrings": {
         "type": "object",
         "minProperties": 1,
         "additionalProperties": { "type": "string" }
      },
      "filter": {
         "type": "object",
         "additionalProperties": false,
         "required": ["key", "type"],
         "properties": {
            "key": { "type": "string", "minLength": 1 },
            "type": {
               "type": "string",
               "enum": ["select", "date", "checkbox"]
            }
         }
      },
      "chart": {
         "type": "object",
         "additionalProperties": false,
         "required": ["field", "type", "size"],
         "properties": {
            "field": { "type": "string", "minLength": 1 },
            "type": {
               "type": "string",
               "enum": ["bar", "pie", "dateline"]
            },
            "size": {
               "type": "integer",
               "minimum": 1,
               "maximum": 4
            }
         }
      },
      "model": {
         "type": "object",
         "additionalProperties": false,
         "required": ["label"],
         "properties": {
            "label": { "$ref": "#/$defs/i18nStrings" },
            "title": { "$ref": "#/$defs/i18nStrings" },
            "description": { "$ref": "#/$defs/i18nStrings" },
            "filters": {
               "type": "array",
               "items": { "$ref": "#/$defs/filter" }
            },
            "columns": {
               "type": "array",
               "items": { "type": "string", "minLength": 1 }
            },
            "charts": {
               "type": "array",
               "items": { "$ref": "#/$defs/chart" }
            }
         }
      }
   }
}
