server {
    gzip on;
    gzip_types text/tab-separated-values application/json application/javascript text/css;

    listen ${NGINX_LISTEN_PORT};

    # portal.json is served only by Next.js (public/portal.json); proxied via location /.

    location /api {
        proxy_pass http://${UPSTREAM_API_HOST}:${UPSTREAM_API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        client_max_body_size 1000M;
    }

    location / {
        proxy_pass http://${UPSTREAM_NEXT_HOST}:${UPSTREAM_NEXT_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        client_max_body_size 1000M;
    }
}
