{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.schema.json",
  "title": "BioGenome portal configuration",
  "type": "object",
  "required": ["general"],
  "additionalProperties": false,
  "properties": {
     "$schema": {
        "type": "string",
        "description": "Optional pointer to this schema (for editor validation)."
     },
     "general": {
        "type": "object",
        "description": "Portal-wide settings (branding, feature flags, languages).",
        "additionalProperties": true,
        "properties": {
           "title": { "$ref": "#/$defs/i18nStrings" },
           "description": { "$ref": "#/$defs/i18nStrings" },
           "kicker": {
              "description": "Small eyebrow label shown above the home page hero title.",
              "allOf": [{ "$ref": "#/$defs/i18nStrings" }]
           },
           "titleHighlight": {
              "description": "Substring matched inside the localized title (first occurrence, case-insensitive); rendered with the portal primary color on the home page.",
              "allOf": [{ "$ref": "#/$defs/i18nStrings" }]
           },
           "cms": { "type": "boolean" },
           "goat": { "type": "boolean", "description": "Enable GoaT pipeline / target-list filters, columns, charts, and home GOAT status." },
           "goatProjectLink": {
              "type": "string",
              "minLength": 1,
              "description": "Optional http(s) URL to this portal's Genomes on a Tree (GoaT) project. When set, the species list GoaT drawer shows a \"View in GoaT\" button."
           },
           "enaTemplate": {
              "type": "boolean",
              "description": "Enable the ENA submission template flow on the CMS \"My data\" / dashboard biosamples tab."
           },
           "map": {
              "type": "boolean",
              "description": "Enable the geographic explorer route and actions. Defaults to true when omitted."
           },
           "languages": {
              "type": "array",
              "items": { "type": "string" }
           },
           "featuredTaxids": {
              "type": "array",
              "description": "NCBI taxids to highlight on the home page (featured taxa cards).",
              "items": { "type": "string", "pattern": "^[0-9]+$" }
           },
           "externalLink": {
              "type": "string",
              "minLength": 1,
              "description": "Optional http(s) URL. When set, the navbar brand and home page footer brand link out to it instead of the portal home route."
           },
           "contactEmail": {
              "type": "string",
              "minLength": 1,
              "description": "Optional support/contact email shown as a mailto link on the CMS login page (\"Forgot your password?\")."
           },
           "showCountries": {
              "type": "boolean",
              "description": "Show the country filter (species list) and country section (species detail). Defaults to true when omitted. Overrides the build-time NEXT_PUBLIC_SHOW_COUNTRIES image default when set; last one wins."
           },
           "matomo": {
              "type": "object",
              "description": "Not yet wired into the Next Matomo tracker; currently only settable via NEXT_PUBLIC_MATOMO_URL/NEXT_PUBLIC_MATOMO_SITE_ID Docker build args (see front/components/matomo-tracker.tsx). Documented here so the shape is visible ahead of a future migration into portal.json.",
              "additionalProperties": false,
              "properties": {
                 "url": { "type": "string", "minLength": 1, "description": "Matomo instance base URL, e.g. https://stats.example.org/matomo/." },
                 "siteId": { "type": "string", "minLength": 1, "description": "Matomo numeric site ID (as a string)." }
              }
           }
        }
     },
     "theme": {
        "type": "object",
        "additionalProperties": false,
        "required": ["colors"],
        "properties": {
           "colors": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary", "secondary"],
              "properties": {
                 "primary": { "type": "string", "minLength": 1 },
                 "secondary": { "type": "string", "minLength": 1 },
                 "accent": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional accent color (defaults to secondary when omitted)."
                 },
                 "variables": {
                    "type": "object",
                    "description": "Legacy: prefer flat primary/secondary on colors.",
                    "additionalProperties": { "type": "string" }
                 }
              }
           }
        }
     },
     "cms": {
        "type": "object",
        "description": "CMS-only options (organism form step requirements, etc.).",
        "additionalProperties": false,
        "properties": {
           "organisms": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                 "requiredSteps": {
                    "type": "array",
                    "description": "Organism form step IDs that are mandatory; other steps use built-in defaults.",
                    "items": { "$ref": "#/$defs/organismFormStepId" }
                 },
                 "steps": {
                    "type": "array",
                    "description": "Deprecated: prefer requiredSteps. Legacy per-step overrides (enabled is ignored at runtime).",
                    "items": { "$ref": "#/$defs/cmsOrganismFormStepWire" }
                 },
                 "form": {
                    "type": "object",
                    "description": "Deprecated: prefer top-level requiredSteps / steps under organisms.",
                    "additionalProperties": false,
                    "properties": {
                       "requiredSteps": {
                          "type": "array",
                          "items": { "$ref": "#/$defs/organismFormStepId" }
                       },
                       "steps": {
                          "type": "array",
                          "items": { "$ref": "#/$defs/cmsOrganismFormStepWire" }
                       }
                    }
                 },
                 "fields": {
                    "type": "array",
                    "description": "Custom picklist fields rendered in the CMS organism form, grouped by step; values are stored under organism.metadata[key]. Use this only for closed, portal-wide enums (e.g. sequencing_type). Do NOT use it for PI / institute / program-style catalogs that grow over time or are 'owned' by a specific curator — those belong in the OrganismPrincipal API (server/db/model.py, /api/organism_principals), linked via BioGenomeUser.principal_ids and projected onto species through assigned curators. See biogenome-portal/docs/cbp-pi-contributor-migration.md.",
                    "items": { "$ref": "#/$defs/cmsOrganismFieldWire" }
                 }
              }
           }
        }
     },
     "models": {
        "type": "object",
        "description": "Optional catalog overrides. `local_samples` and `annotations` card/export layouts may be configured; other catalog models use built-in defaults.",
        "additionalProperties": false,
        "properties": {
           "local_samples": { "$ref": "#/$defs/model" },
           "annotations": { "$ref": "#/$defs/model" }
        }
     },
     "footer": {
        "type": "object",
        "description": "Home page footer: optional logo path and i18n lines.",
        "additionalProperties": false,
        "properties": {
           "logoUrl": {
              "type": "string",
              "minLength": 1,
              "description": "Public path under Next `public/` (e.g. /portal-logo.png). Must match the mounted file; omit for title-only branding."
           },
           "copyright": { "$ref": "#/$defs/i18nStrings" },
           "tagline": {
              "description": "Optional secondary line below copyright.",
              "allOf": [{ "$ref": "#/$defs/i18nStrings" }]
           }
        }
     }
  },
  "$defs": {
     "organismFormStepId": {
        "type": "string",
        "enum": [
           "selectOrganism",
           "goatStatus",
           "sequencingAndSubproject",
           "images",
           "publications",
           "vernacularNames",
           "extraMetadata",
           "reviewSubmit"
        ]
     },
     "cmsOrganismFormStepWire": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
           "id": {
              "type": "string",
              "enum": ["goatStatus", "images"]
           },
           "required": { "type": "boolean" },
           "enabled": { "type": "boolean" }
        }
     },
     "cmsOrganismFieldWire": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type", "step", "values"],
        "properties": {
           "key": { "type": "string", "minLength": 1 },
           "label": { "type": "string", "minLength": 1 },
           "type": { "type": "string", "enum": ["single", "multi"] },
           "step": { "$ref": "#/$defs/organismFormStepId" },
           "required": { "type": "boolean" },
           "values": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
           }
        }
     },
     "i18nStrings": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": { "type": "string" }
     },
     "filter": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type"],
        "properties": {
           "key": { "type": "string", "minLength": 1 },
           "type": {
              "type": "string",
              "enum": [
                 "select",
                 "date",
                 "checkbox",
                 "input",
                 "histogramDate",
                 "experimentList",
                 "thresholdToggle",
                 "thresholdPair",
                 "referenceGenome"
              ]
           },
           "label": { "$ref": "#/$defs/i18nStrings" },
           "checkboxLabel": {
              "$ref": "#/$defs/i18nStrings",
              "description": "Optional label for referenceGenome checkbox line (section title uses label)."
           },
           "threshold": { "type": "number", "description": "Lower bound for thresholdToggle (__gte)." },
           "thresholdPair": {
              "type": "array",
              "description": "Per-row key + threshold for thresholdPair (state under each key).",
              "items": {
                 "type": "object",
                 "required": ["key", "threshold"],
                 "additionalProperties": false,
                 "properties": {
                    "key": { "type": "string", "minLength": 1 },
                    "threshold": { "type": "number" },
                    "label": { "$ref": "#/$defs/i18nStrings" }
                 }
              }
           }
        }
     },
     "chart": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "type"],
        "properties": {
           "field": { "type": "string", "minLength": 1 },
           "type": {
              "type": "string",
              "enum": ["bar", "pie", "dateline", "scatter"]
           },
           "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Optional in JSON; defaults are applied when normalizing config."
           },
           "model": { "type": "string" },
           "xField": { "type": "string", "description": "Scatter charts: X axis (dot path)." },
           "yField": { "type": "string", "description": "Scatter charts: Y axis (dot path)." },
           "colorField": { "type": "string", "description": "Scatter charts: categorical color (dot path)." }
        }
     },
     "catalogCardField": {
        "type": "object",
        "description": "Catalog record card row: API field dot-path, optional i18n label, Lucide icon name, section group.",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
           "key": { "type": "string", "minLength": 1 },
           "label": { "$ref": "#/$defs/i18nStrings" },
           "icon": {
              "type": "string",
              "description": "Lucide icon name resolved by the catalog card UI (e.g. `Globe`, `Calendar`)."
           },
           "section": {
              "type": "string",
              "enum": ["meta", "stats", "location", "identifiers", "annotation"]
           }
        }
     },
     "model": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
           "label": { "$ref": "#/$defs/i18nStrings" },
           "title": {
              "$ref": "#/$defs/i18nStrings",
              "description": "Deprecated: use label."
           },
           "description": { "$ref": "#/$defs/i18nStrings" },
           "icon": { "type": "string" },
           "filters": {
              "type": "array",
              "items": { "$ref": "#/$defs/filter" }
           },
           "columns": {
              "type": "array",
              "description": "Deprecated: prefer `cardFields` + `exportFields`. Migration shim derives card fields from this list.",
              "items": { "type": "string", "minLength": 1 }
           },
           "cardFields": {
              "type": "array",
              "description": "Body fields for the catalog card (list view). Sections group related fields.",
              "items": { "$ref": "#/$defs/catalogCardField" }
           },
           "sortableFields": {
              "type": "array",
              "description": "API `sort_column` keys offered in the catalog sort menu.",
              "items": { "type": "string", "minLength": 1 }
           },
           "exportFields": {
              "type": "array",
              "description": "TSV / JSONL export field paths; taxon + id fields are prepended automatically.",
              "items": { "type": "string", "minLength": 1 }
           },
           "charts": {
              "type": "array",
              "items": { "$ref": "#/$defs/chart" }
           }
        }
     }
  }
}
