# Optional: point at Flask when using `next dev` (overrides portal.json `general.apiBase`).
# Matches docker-compose-DEV bgp_server "90:5000" without going through nginx on 91.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:90/api

# Optional: overrides portal.json `general.rootTaxid`.
