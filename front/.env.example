# Optional overrides (see `lib/api/taxon.ts`). Prefer `general.apiBase` and `general.rootTaxid` in `public/portal.json`.

# Force API URL (e.g. `next dev` with Flask on another port). Must include `/api`, no trailing slash.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:5000/api

# Force root taxid before portal.json `general.rootTaxid`.
# NEXT_PUBLIC_ROOT_TAXID=131567

# Next.js basePath (baked at build). Deploy subpath: set in Docker build-arg `NEXT_PUBLIC_BASE_PATH`.
# NEXT_PUBLIC_BASE_PATH=

# Local dev: copy to `.env.development` or `.env.local`; see `.env.development` for a typical Flask URL.

# Server-side fetch only (RSC, Route Handlers). Origin of Flask, no path (no trailing slash).
# Required when `general.apiBase` is path-only (e.g. `/bgp/api`). Docker: `http://bgp_server:5000`.
# INTERNAL_FETCH_ORIGIN=http://127.0.0.1:90
